{
  "title": "Network Overview",
  "panels": [
    {
      "type": "stat",
      "title": "BGP Sessions Established",
      "targets": [
        {
          "expr": "sum(frr_bgp_peer_state{state=\"established\"}) or vector(0)",
          "refId": "A"
        }
      ],
      "gridPos": {"x": 0, "y": 0, "w": 8, "h": 6}
    },
    {
      "type": "timeseries",
      "title": "Prefixes Received",
      "targets": [
        {
          "expr": "frr_bgp_peer_prefixes_received",
          "legendFormat": "{{peer}}"
        }
      ],
      "gridPos": {"x": 8, "y": 0, "w": 16, "h": 6}
    }
  ],
  "schemaVersion": 38,
  "timezone": "browser"
}
